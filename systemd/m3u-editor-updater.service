[Unit]
Description=m3u-editor autonomous updater
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/m3u-editor-updater
ExecStart=/usr/bin/node /opt/m3u-editor-updater/updater.js
Environment=M3U_UPDATER_CONFIG=/opt/m3u-editor-updater/config/config.json
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15min
